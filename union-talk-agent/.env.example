# Process
AGENT_ENVIRONMENT=local
AGENT_LOG_LEVEL=INFO
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=13007
AGENT_FIXED_ANSWER_ENABLED=false
AGENT_FIXED_ANSWER_TEXT="[联调模式] Agent 固定回答。"
AGENT_ID_WORKER_ID=1
AGENT_ID_DATACENTER_ID=1
AGENT_API_KEY_MASTER_KEY=
AGENT_RECONCILIATION_INTERVAL_SECONDS=30
AGENT_RUN_LEASE_SECONDS=90
AGENT_RUN_HEARTBEAT_SECONDS=20

# PostgreSQL
AGENT_POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/union_talk
AGENT_POSTGRES_POOL_SIZE=10
AGENT_POSTGRES_MAX_OVERFLOW=20
AGENT_POSTGRES_POOL_TIMEOUT_SECONDS=10

# RabbitMQ
AGENT_RABBITMQ_URL=amqp://union_talk:change-me@127.0.0.1:5672/%2Funion_talk
AGENT_RABBITMQ_PREFETCH_COUNT=8
AGENT_RABBITMQ_CONSUMER_CONCURRENCY=4
AGENT_RABBITMQ_RECONNECT_INTERVAL_SECONDS=5
AGENT_RABBITMQ_RETRY_DELAY_SECONDS=5
AGENT_RABBITMQ_MAX_DELIVERY_ATTEMPTS=5

# Scanned PDF OCR
AGENT_OCR_ENABLED=true
AGENT_OCR_LANGUAGES=chi_sim+eng
AGENT_OCR_DPI=220
AGENT_OCR_PAGE_TIMEOUT_SECONDS=60
AGENT_OCR_MAX_PAGES=100

# Redis realtime
AGENT_REDIS_URL=redis://127.0.0.1:6379/0
AGENT_REDIS_USERNAME=
AGENT_REDIS_PASSWORD=
AGENT_REDIS_ENABLED=true
AGENT_REDIS_RUN_TTL_SECONDS=86400
AGENT_REDIS_STREAM_MAX_LENGTH=2000

# Message gRPC
AGENT_GRPC_MESSAGE_TARGET=127.0.0.1:19005
AGENT_GRPC_FILE_TARGET=127.0.0.1:19006
AGENT_GRPC_DEADLINE_SECONDS=5

# Nacos service discovery
AGENT_NACOS_ENABLED=true
AGENT_NACOS_SERVER_ADDRESSES=127.0.0.1:18848
AGENT_NACOS_NAMESPACE_ID=union-talk
AGENT_NACOS_GROUP_NAME=DEFAULT_GROUP
AGENT_NACOS_SERVICE_NAME=union-talk-agent
AGENT_NACOS_CLUSTER_NAME=DEFAULT
AGENT_NACOS_INSTANCE_IP=127.0.0.1
AGENT_NACOS_USERNAME=nacos
AGENT_NACOS_PASSWORD=nacos
AGENT_NACOS_WEIGHT=1.0
AGENT_NACOS_GRPC_TIMEOUT_MS=5000

# DeepSeek defaults
AGENT_MODEL_DEEPSEEK_API_BASE=https://api.deepseek.com
AGENT_MODEL_DEEPSEEK_MODEL_ID=deepseek-chat
AGENT_MODEL_TIMEOUT_SECONDS=60
AGENT_MODEL_MAX_RETRIES=2

# Milvus and embedding
AGENT_MILVUS_URI=http://127.0.0.1:19530
AGENT_MILVUS_TOKEN=
AGENT_MILVUS_ENABLED=true
AGENT_MILVUS_COLLECTION_NAME=union_talk_rag_v2
AGENT_EMBEDDING_API_BASE=http://127.0.0.1:13008
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_MODEL=BAAI/bge-m3
AGENT_EMBEDDING_DIMENSION=1024
AGENT_EMBEDDING_TIMEOUT_SECONDS=30
AGENT_EMBEDDING_BATCH_SIZE=16
AGENT_EMBEDDING_BATCH_WAIT_MILLISECONDS=10
AGENT_EMBEDDING_QUEUE_CAPACITY=1024

# Worker switches
AGENT_ANSWER_WORKER_ENABLED=true
AGENT_INDEX_WORKER_ENABLED=true
AGENT_RECONCILIATION_WORKER_ENABLED=true
