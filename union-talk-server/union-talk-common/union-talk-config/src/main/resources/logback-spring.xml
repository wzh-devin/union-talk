<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 复用 Spring Boot 默认颜色和异常转换器。 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 应用与日志级别。 -->
    <springProperty scope="context" name="APP_NAME"
                    source="spring.application.name" defaultValue="union-talk"/>
    <springProperty scope="context" name="LOG_PATH"
                    source="logging.file.path" defaultValue="logs"/>
    <springProperty scope="context" name="ROOT_LEVEL"
                    source="logging.level.root" defaultValue="INFO"/>
    <springProperty scope="context" name="APP_LEVEL"
                    source="logging.level.com.devin.uniontalk" defaultValue="INFO"/>

    <!-- 全量日志滚动策略。 -->
    <springProperty scope="context" name="MAX_FILE_SIZE"
                    source="logging.logback.rollingpolicy.max-file-size" defaultValue="100MB"/>
    <springProperty scope="context" name="SERVICE_MAX_HISTORY"
                    source="logging.logback.rollingpolicy.max-history" defaultValue="30"/>
    <springProperty scope="context" name="SERVICE_TOTAL_SIZE_CAP"
                    source="logging.logback.rollingpolicy.total-size-cap" defaultValue="10GB"/>
    <springProperty scope="context" name="CLEAN_HISTORY_ON_START"
                    source="logging.logback.rollingpolicy.clean-history-on-start" defaultValue="true"/>

    <!-- 错误日志与异步队列。 -->
    <springProperty scope="context" name="ERROR_MAX_HISTORY"
                    source="union-talk.logging.error-max-history" defaultValue="60"/>
    <springProperty scope="context" name="ERROR_TOTAL_SIZE_CAP"
                    source="union-talk.logging.error-total-size-cap" defaultValue="5GB"/>
    <springProperty scope="context" name="ASYNC_QUEUE_SIZE"
                    source="union-talk.logging.async-queue-size" defaultValue="2048"/>

    <!-- 控制台保留旧版彩色风格，文件不写入 ANSI 控制字符。 -->
    <property name="UNION_CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr([${APP_NAME}]){cyan} %clr([PID:${PID:-N/A}]){magenta} %clr([traceId:%X{traceId:-N/A}]){yellow} [ %thread ] %clr(%-5level) %blue(%logger{50}) %magenta(:::) %msg%n%wEx"/>
    <property name="UNION_FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [${APP_NAME}] [PID:${PID:-N/A}] [traceId:%X{traceId:-N/A}] [ %thread ] %-5level %logger{50} ::: %msg%n%wEx"/>

    <!-- 控制台在所有 Profile 中启用。 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${UNION_CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Test Profile 不初始化文件 Appender，避免创建日志文件。 -->
    <springProfile name="test">
        <root level="${ROOT_LEVEL}">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- 非 Test Profile 同时输出控制台、错误文件和异步全量文件。 -->
    <springProfile name="!test">
        <appender name="SERVICE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/${APP_NAME}/service/service.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>
                    ${LOG_PATH}/${APP_NAME}/service/service.%d{yyyy-MM-dd}.%i.log.gz
                </fileNamePattern>
                <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
                <maxHistory>${SERVICE_MAX_HISTORY}</maxHistory>
                <totalSizeCap>${SERVICE_TOTAL_SIZE_CAP}</totalSizeCap>
                <cleanHistoryOnStart>${CLEAN_HISTORY_ON_START}</cleanHistoryOnStart>
            </rollingPolicy>
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>${UNION_FILE_LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/${APP_NAME}/error/error.log</file>
            <filter class="ch.qos.logback.classic.filter.LevelFilter">
                <level>ERROR</level>
                <onMatch>ACCEPT</onMatch>
                <onMismatch>DENY</onMismatch>
            </filter>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>
                    ${LOG_PATH}/${APP_NAME}/error/error.%d{yyyy-MM-dd}.%i.log.gz
                </fileNamePattern>
                <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
                <maxHistory>${ERROR_MAX_HISTORY}</maxHistory>
                <totalSizeCap>${ERROR_TOTAL_SIZE_CAP}</totalSizeCap>
                <cleanHistoryOnStart>${CLEAN_HISTORY_ON_START}</cleanHistoryOnStart>
            </rollingPolicy>
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>${UNION_FILE_LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <appender name="ASYNC_SERVICE_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>${ASYNC_QUEUE_SIZE}</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>false</neverBlock>
            <includeCallerData>false</includeCallerData>
            <maxFlushTime>5000</maxFlushTime>
            <appender-ref ref="SERVICE_FILE"/>
        </appender>

        <root level="${ROOT_LEVEL}">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ERROR_FILE"/>
            <appender-ref ref="ASYNC_SERVICE_FILE"/>
        </root>
    </springProfile>

    <!-- 应用 Logger 只设置级别，通过 Additivity 交给 Root Appender。 -->
    <logger name="com.devin.uniontalk" level="${APP_LEVEL}"/>
</configuration>
