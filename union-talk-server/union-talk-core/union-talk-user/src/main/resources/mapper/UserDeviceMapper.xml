<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.devin.uniontalk.user.mapper.UserDeviceMapper">

    <resultMap id="BaseResultMap" type="com.devin.uniontalk.user.domain.entity.UserDevice">
        <result column="id" property="id" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="device_name" property="deviceName" jdbcType="VARCHAR"/>
        <result column="device_type" property="deviceType" jdbcType="VARCHAR"/>
        <result column="ip_address" property="ipAddress" jdbcType="OTHER"/>
        <result column="user_agent" property="userAgent" jdbcType="VARCHAR"/>
        <result column="last_active_at" property="lastActiveAt" jdbcType="TIMESTAMP"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
    </resultMap>

</mapper>
