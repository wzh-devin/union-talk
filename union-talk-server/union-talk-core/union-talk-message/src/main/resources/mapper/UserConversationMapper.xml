<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.devin.uniontalk.message.mapper.UserConversationMapper">

    <resultMap id="BaseResultMap" type="com.devin.uniontalk.message.domain.entity.UserConversation">
