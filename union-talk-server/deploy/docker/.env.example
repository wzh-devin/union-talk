# ---------- 镜像 ----------
# 示例：registry.example.com/union-talk
UNION_TALK_IMAGE_PREFIX=registry.example.com/union-talk
# 必须使用不可变、可回滚的版本标签，不建议使用 latest
UNION_TALK_IMAGE_TAG=v1.0.0

# ---------- 宿主机私网地址 ----------
# 中间件均在同一宿主机时，各 HOST 填写宿主机私网 IP，不能填写 127.0.0.1
UNION_NACOS_HOST=192.168.1.100
UNION_NACOS_PORT=18848
UNION_NACOS_NAMESPACE=union-talk
UNION_NACOS_GROUP=DEFAULT_GROUP
UNION_NACOS_USERNAME=nacos
UNION_NACOS_PASSWORD=change-me

UNION_POSTGRESQL_HOST=192.168.1.100
UNION_POSTGRESQL_PORT=5432
UNION_POSTGRESQL_USERNAME=union_talk
UNION_POSTGRESQL_PASSWORD=change-me
UNION_POSTGRESQL_DATABASE=union_talk
UNION_POSTGRESQL_SCHEMA=public

UNION_REDIS_HOST=192.168.1.100
UNION_REDIS_PORT=6379
UNION_REDIS_PASSWORD=change-me
UNION_REDIS_DATABASE=0

UNION_RABBITMQ_HOST=192.168.1.100
UNION_RABBITMQ_PORT=5672
UNION_RABBITMQ_USERNAME=union_talk
UNION_RABBITMQ_PASSWORD=change-me
UNION_RABBITMQ_VIRTUAL_HOST=/union_talk

UNION_SEATA_HOST=192.168.1.100
UNION_SEATA_PORT=8091

MINIO_ENDPOINT=http://192.168.1.100:9000
# 浏览器能访问的文件公开地址；不要使用容器内地址
MINIO_EXPORT_URL=http://192.168.1.100:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_NAME=union-talk

# ---------- 邮件 ----------
UNION_EMAIL_HOST=smtp.qq.com
UNION_EMAIL_PORT=465
UNION_EMAIL_USERNAME=change-me
UNION_EMAIL_PASSWORD=change-me
UNION_EMAIL_FROM=change-me
UNION_EMAIL_PROTOCOL=smtps
UNION_EMAIL_CODE_EXPIRE=60

# ---------- 应用安全 ----------
# 使用足够长的随机值；六个服务必须保持一致
UNION_CRYPTO_SECRET_KEY=change-me-to-a-long-random-secret

# ---------- 运维 ----------
TZ=Asia/Shanghai
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC

UNION_LOG_ROOT_LEVEL=INFO
UNION_LOG_APP_LEVEL=INFO
UNION_LOG_SPRING_LEVEL=INFO
UNION_LOG_HIBERNATE_LEVEL=INFO
UNION_LOG_HIKARI_LEVEL=INFO
UNION_LOG_MAX_FILE_SIZE=100MB
UNION_LOG_MAX_HISTORY=30
UNION_LOG_TOTAL_SIZE_CAP=10GB
UNION_LOG_CLEAN_HISTORY_ON_START=true
UNION_LOG_ERROR_MAX_HISTORY=60
UNION_LOG_ERROR_TOTAL_SIZE_CAP=5GB
UNION_LOG_ASYNC_QUEUE_SIZE=2048

UNION_DRUID_MONITOR_ENABLED=false
UNION_DRUID_MONITOR_USERNAME=admin
UNION_DRUID_MONITOR_PASSWORD=change-me

# 同一数据中心内，每个应用实例的 worker-id 必须唯一，范围均为 0-31
UNION_ID_GENERATOR_DATACENTER_ID=1
UNION_GATEWAY_WORKER_ID=1
UNION_AUTH_WORKER_ID=2
UNION_USER_WORKER_ID=3
UNION_MESSAGE_WORKER_ID=4
UNION_WEBSOCKET_WORKER_ID=5
UNION_FILE_WORKER_ID=6

# ---------- 对外端口 ----------
UNION_TALK_GATEWAY_HOST_PORT=13000
UNION_NETTY_WEBSOCKET_HOST_PORT=14001

# ---------- WebSocket ----------
UNION_NETTY_WEBSOCKET_PATH=/api/v1/ws
UNION_NETTY_WEBSOCKET_BOSS_THREADS=1
UNION_NETTY_WEBSOCKET_WORKER_THREADS=0
UNION_NETTY_WEBSOCKET_READER_IDLE_SECONDS=30
UNION_NETTY_WEBSOCKET_MAX_CONTENT_LENGTH=8192
UNION_NETTY_WEBSOCKET_MAX_FRAME_PAYLOAD_LENGTH=65536
UNION_NETTY_WEBSOCKET_SO_BACKLOG=128
UNION_NETTY_WEBSOCKET_SO_KEEPALIVE=true
UNION_NETTY_WEBSOCKET_CONNECTION_TTL_SECONDS=90

# ---------- 文件上传 ----------
UNION_FILE_MAX_FILE_SIZE=5MB
UNION_FILE_MAX_REQUEST_SIZE=25MB
UNION_TALK_FILE_GRPC_MAX_INBOUND_MESSAGE_SIZE=25MB
